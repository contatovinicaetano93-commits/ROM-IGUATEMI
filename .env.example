# ROM CLUB IGUATEMI — variáveis de produção (projeto Vercel rom-club-iguatemi)
# Template completo: deploy/vercel-rom-club-iguatemi.env
#
# REQUIRED — Iguatemi (rom-club-iguatemi):
# | Var                   | Valor                                  | Vercel              |
# |-----------------------|----------------------------------------|---------------------|
# | ROM_PANEL             | iguatemi                               | já set — conferir   |
# | AVEC_UNIT_ID          | 99801                                  | VERIFICAR / setar   |
# | AVEC_SKIP_REPORT_0011 | 1                                      | VERIFICAR / setar   |
# | DATABASE_URL          | Supabase pooler (*pooler.supabase.com) | já set — conferir   |
# | ROM_SESSION_SECRET    | openssl rand -hex 32                   | VERIFICAR (prod)    |
# | CRON_SECRET           | openssl rand -hex 32 (≠ Brasil)        | já set — conferir   |
# | AVEC_API_TOKEN        | token loja Iguatemi                    | já set — rotacionar?|
#

ROM_PANEL=iguatemi
NEXT_PUBLIC_ROM_PANEL=iguatemi
ROM_SEED_PRESET=iguatemi

DATABASE_URL=
# Pipeline de schema (db/migrations.json) — boot local; skip no Vercel (VERCEL=1):
#   npm run db:migrate · POST /api/admin/migrations
# ROM_SKIP_BOOT_MIGRATIONS=1  (força skip também em dev local)
# Preferir Supabase Transaction Pooler (6543), senha URL-encoded (@ → %40):
# postgresql://postgres.<project-ref>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Opcional: substring do host esperado (alerta se DATABASE_URL divergir)
# ROM_EXPECTED_DB_HOST=pooler.supabase.com

# Sentry (Next.js) — DSN do projeto desta unidade na org imobi-hl
NEXT_PUBLIC_SENTRY_DSN=
# Opcional — upload de source maps no build (nunca commitar)
# SENTRY_AUTH_TOKEN=

# IA — pode ser a mesma chave Anthropic nos dois projetos (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# WhatsApp — Cloud API oficial (Meta). Phone Number ID da unidade Iguatemi.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_TEMPLATE_AFTERCARE=rom_aftercare
# WHATSAPP_TEMPLATE_LANG=pt_BR
# WHATSAPP_SEND_MODE=auto
# Link de agendamento no WhatsApp pós-visita (opcional) — só Iguatemi; nunca o do BR
WHATSAPP_BOOKING_LINK=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_IDS=

# Telegram — bot dedicado do financeiro (terceiro bot, separado do da equipe)
# Comandos: /financeiro (receita/despesas/margem) e /estoque (valor + alertas)
TELEGRAM_FINANCE_BOT_TOKEN=
TELEGRAM_FINANCE_WEBHOOK_SECRET=
TELEGRAM_FINANCE_CHAT_IDS=

# Avec — TOKEN EXCLUSIVO da loja Iguatemi (REQUIRED)
AVEC_API_URL=https://api.avec.beauty
AVEC_API_TOKEN=
AVEC_UNIT_ID=99801
# 0011 Avec devolve 400 neste salão — pula e usa 0002 local / 0007
AVEC_SKIP_REPORT_0011=1
AVEC_SYNC_MAX_PAGES=
AVEC_WEBHOOK_SECRET=

# Cron — segredo ÚNICO deste projeto Vercel (obrigatório para sync/reminders/etc.)
# Cadência denser (paridade BR): min-gap fast ~12min / full ~5h / webhook ~90s
# vercel.json: sync 10,30,50 * * * *, full :35 10,22 UTC, token 30 */3h,
# estoque horário (:35), purge 07:25 UTC — minutos ≠ Brasil (anti-colisão Avec)
CRON_SECRET=

# Segredo HMAC das sessões (REQUIRED em produção — independente da senha de login)
ROM_SESSION_SECRET=

# Login — senha por papel (ver template completo pra detalhes de cada um)
# Admin: ROM_ADMIN_USER / ROM_ADMIN_PASSWORD (ou legado ROM_ACCESS_TOKEN só como senha)
ROM_STAFF_USER=FUNC-IGUATEMI
ROM_STAFF_PASSWORD=
# Financeiro: painel próprio (/financeiro) + acesso duplo ao estoque (/estoque)
ROM_FINANCE_USER=FINANCEIRO-IGUATEMI
ROM_FINANCE_PASSWORD=
# Estoque: painel próprio e isolado (/estoque) — não vê financeiro, contatos, hoje, dashboard
ROM_STOCK_USER=ESTOQUE-IGUATEMI
ROM_STOCK_PASSWORD=
# Legacy (não usar como Bearer em APIs — só CRON_SECRET para automação)
ROM_ACCESS_TOKEN=

# Demo Avec sem token (só desenvolvimento)
AVEC_MOCK=

# Omie — 2 CNPJs por unidade (Serviços + Comércio)
# Serviços = salão; Comércio = produtos
OMIE_SERVICOS_APP_KEY=
OMIE_SERVICOS_APP_SECRET=
OMIE_COMERCIO_APP_KEY=
OMIE_COMERCIO_APP_SECRET=
# OMIE_API_URL=https://app.omie.com.br/api/v1
# OMIE_MOCK=1

