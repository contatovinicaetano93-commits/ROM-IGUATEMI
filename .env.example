# =============================================================================
# ROM — variáveis por instância (Brasil e Iguatemi são INDEPENDENTES)
# =============================================================================
# Templates prontos para colar na Vercel:
#   deploy/vercel-rom-club-brasil.env
#   deploy/vercel-rom-club-iguatemi.env
# Guia Iguatemi: deploy/SETUP-IGUATEMI.md
# =============================================================================
#
# REQUIRED — Brasil (rom-club-brasil):
# | Var                | Valor                                  | Vercel              |
# |--------------------|----------------------------------------|---------------------|
# | ROM_PANEL          | brasil                                 | já set — conferir   |
# | AVEC_UNIT_ID       | 40613                                  | VERIFICAR / setar   |
# | DATABASE_URL       | Neon pooler (*.neon.tech)              | já set — conferir   |
# | ROM_SESSION_SECRET | openssl rand -hex 32                   | VERIFICAR (prod)    |
# | CRON_SECRET        | openssl rand -hex 32 (≠ Iguatemi)      | já set — conferir   |
# | AVEC_API_TOKEN     | token loja Brasil                      | já set — rotacionar?|
#
# =============================================================================

# --- Postgres (1 banco POR projeto Vercel) ---
# Brasil / Iguatemi: Neon pooler (um projeto Neon por unidade).
#   host: *-pooler.*.aws.neon.tech  |  sslmode=require  |  prepare:false (postgres.js)
# Guard (repo BR): npm run check:brasil-db-host  (falha se host for supabase.com)
DATABASE_URL=
# Intranet (colaboradores, CMS, RomFlow). Pode apontar ao mesmo Neon da unidade.
# Se vazio, a intranet usa DATABASE_URL.
INTRANET_DATABASE_URL=
# Pipeline de schema (db/migrations.json) — roda no boot nodejs e via:
#   npm run db:migrate
#   POST /api/admin/migrations
# Boot migrations: desligadas no Vercel (VERCEL=1) — use POST /api/admin/migrations ou db:migrate no deploy.
# ROM_SKIP_BOOT_MIGRATIONS=1  (força skip também em dev local)

# --- Painel desta instância (mesmo valor nos dois campos) ---
ROM_PANEL=brasil
NEXT_PUBLIC_ROM_PANEL=brasil
ROM_SEED_PRESET=brasil
# Meta de faturamento diário (R$) — KPI "Meta do dia" em intelligence.ts
SALON_DAILY_GOAL=5000

# Sentry (Next.js) — DSN do projeto desta unidade na org imobi-hl
NEXT_PUBLIC_SENTRY_DSN=
# Opcional — upload de source maps no build (nunca commitar)
# SENTRY_AUTH_TOKEN=

# PostHog — token do projeto nesta instância (mesmo valor roteado via /ingest)
# Definir só na Vercel — não commitar valores reais
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# IA — pode ser a mesma chave Anthropic nos dois projetos (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# WhatsApp — Cloud API oficial (Meta). 1 número/Phone Number ID POR unidade.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional — default v21.0
# WHATSAPP_CLOUD_API_VERSION=v21.0
# Verificação do webhook Meta (GET hub.verify_token)
WHATSAPP_VERIFY_TOKEN=
# Assinatura X-Hub-Signature-256 (App Secret do app Meta) — preferido em produção
WHATSAPP_APP_SECRET=
# Fallback de auth do webhook (testes); Cloud API oficial usa APP_SECRET
WHATSAPP_WEBHOOK_SECRET=
# Template aprovado para aftercare fora da janela 24h (opcional mas recomendado)
# WHATSAPP_TEMPLATE_AFTERCARE=rom_aftercare
# WHATSAPP_TEMPLATE_LANG=pt_BR
# WHATSAPP_TEMPLATE_BODY_PARAM=1
# Opcional — auto | text | template (default auto)
# WHATSAPP_SEND_MODE=auto
# Link de agendamento no WhatsApp pós-visita (opcional)
WHATSAPP_BOOKING_LINK=
# Alertas internos (estoque crítico, lembretes financeiros) — E.164 sem +
FINANCE_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBER=
# Botão flutuante RH (intranet). Default 11993455589 se vazio.
NEXT_PUBLIC_RH_WHATSAPP_NUMBER=

# Telegram — opcional/legado (1 bot POR unidade; equipe opera pelo WhatsApp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_IDS=

# Telegram — bot dedicado do financeiro (terceiro bot, separado do da equipe)
# Comandos: /financeiro (receita/despesas/margem) e /estoque (valor + alertas)
TELEGRAM_FINANCE_BOT_TOKEN=
TELEGRAM_FINANCE_WEBHOOK_SECRET=
TELEGRAM_FINANCE_CHAT_IDS=

# Avec — TOKEN DIFERENTE por unidade (API da loja Brasil ≠ Iguatemi)
# Auth: header Authorization = token puro (sem Bearer). Base: https://api.avec.beauty/reports/{id}
# Token estável: pedir ao suporte Avec. Temporary: no painel logado → DevTools → Application →
# localStorage → chave "token" (JWT salaovip, expira ~12h — só para teste).
AVEC_API_URL=https://api.avec.beauty
AVEC_API_TOKEN=
# ID da unidade no painel Avec — escopa o sync (REQUIRED Brasil = 40613)
AVEC_UNIT_ID=40613
AVEC_SYNC_MAX_PAGES=
# Janela de dias do sync de receita (override; senão fast=1 / full=7)
# AVEC_REVENUE_DAYS_BACK=7
# Backfill do ano (script): npx tsx scripts/run-revenue-month-backfill.ts
# Ou admin: POST /api/admin/revenue-backfill (chunks de 31d até done=true)
# Faturamento diário — padrão 0088 (override se a unidade usar outro)
# AVEC_REPORT_REVENUE=0088
# Override do relatório 0011 (diretoria); padrão = 0011
AVEC_REPORT_DIRECTOR_RETURN=
# Escape hatch: força 0011 local (0002+0007) em vez do 0011 Avec
# AVEC_SKIP_REPORT_0011=1
# Tempo real — URL: https://SEU-DOMINIO/api/webhooks/avec  Header: x-avec-secret
AVEC_WEBHOOK_SECRET=

# Cron — segredo ÚNICO por projeto Vercel (evita que um cron dispare no outro)
# vercel.json (Brasil): fast 5,25,45 * * * * · full ops/agenda/catalog 2×/dia (10h/22h UTC)
# · director-visits 10 11,23 · director-0021 25 11,23 · estoque 5 */3 * * *
# · estoque full 40 11 * * * · token 0 */3 * * * · purge 10 7 * * * · Omie 15 8 * * *
# · lembrete financeiro WhatsApp: 0 12 * * 1 (segunda 12:00 UTC ≈ 09:00 SP)
CRON_SECRET=

# =============================================================================
# ROLES & ACCESS CONTROL
# =============================================================================
# Each role has specific dashboard access and is isolated from others.
# See src/middleware.ts for isolation logic.
#
# LOGIN — password PER unit (recommended to rotate monthly)
#
# Admin: Full access (all dashboards + admin panel)
ROM_ADMIN_USER=ADMIN-BRASIL
ROM_ADMIN_PASSWORD=
# Access: /, /hoje, /dashboard, /admin, /contatos, /pipeline, /financeiro, /estoque, /onboarding, /relatorios
# Segredo HMAC das sessões (REQUIRED em produção — independente da senha)
ROM_SESSION_SECRET=
#
# Staff: operação do dia (sem receita / admin / visão analítica)
ROM_STAFF_USER=FUNC-BRASIL
ROM_STAFF_PASSWORD=
# Access: /hoje, /pipeline, /contatos, /onboarding (não: dashboard, financeiro, estoque, admin, relatorios)
#
# Finance (Financeiro): Financial dashboard + dual access to stock
ROM_FINANCE_USER=FINANCEIRO-BRASIL
ROM_FINANCE_PASSWORD=
# Access: /financeiro, /estoque (duplo), /relatorios, /onboarding (não: hoje, dashboard, contatos, admin)
# Note: Financeiro cuida de AMBOS financeiro e estoque
#
# Stock (Estoque): Inventory management (isolated from finance & other areas)
ROM_STOCK_USER=ESTOQUE-BRASIL
ROM_STOCK_PASSWORD=
# Access: /estoque, /onboarding only (não: financeiro, hoje, dashboard, contatos, admin)
# Note: Estoque é isolado — nunca vê financeiro ou operações gerais
#
# Legacy (não usar como Bearer em APIs — só CRON_SECRET para automação)
ROM_ACCESS_TOKEN=

# Demo Avec sem token (só desenvolvimento)
AVEC_MOCK=

# Relatório diretoria (terça 08:00) — e-mail via Resend
# CREATE_USER (cadastro em /pessoas) reusa o mesmo RESEND_API_KEY e os e-mails
# de intranet_employees (sobreposição de área / admin / master) — sem env por área.
RESEND_API_KEY=
DIRECTOR_REPORT_EMAIL=contato.vinicaetano93@gmail.com
# DIRECTOR_REPORT_FROM=ROM CLUB BRASIL <onboarding@resend.dev>
# RESEND_FROM=ROM CLUB BRASIL <onboarding@resend.dev>

# Folha PJ — IMAP DARF/DAS (cron /api/folha/imap-poll seg–sex 12:00 UTC)
# FOLHA_IMAP_HOST=
# FOLHA_IMAP_PORT=993
# FOLHA_IMAP_USER=
# FOLHA_IMAP_PASS=
# FOLHA_IMAP_MAILBOX=INBOX
# FOLHA_IMAP_TLS_INSECURE=0
# E-mail ao aprovar a folha (Resend) — ops/RH
# FOLHA_NOTIFY_EMAIL=
# FOLHA_NOTIFY_FROM=

# Split fiscal (CBS/IBS) — conciliação no Financeiro (consumidor, não PSP)
# Feed merchant/sandbox ou export do PSP no formato da Plataforma Pública (RFB/CGIBS)
FISCAL_SPLIT_API_URL=
FISCAL_SPLIT_API_KEY=
FISCAL_SPLIT_ENV=sandbox
FISCAL_SPLIT_TIMEOUT_MS=15000
# FISCAL_SPLIT_MOCK=1

# Omie — 2 CNPJs por unidade (Contas a Pagar → despesas por categoria)
# Serviços = salão (unha, corte, coloração…). Comércio = produtos (shampoo, creme…).
# Nunca committe as chaves. Vercel → Environment Variables (Production) por projeto.
OMIE_SERVICOS_APP_KEY=
OMIE_SERVICOS_APP_SECRET=
OMIE_COMERCIO_APP_KEY=
OMIE_COMERCIO_APP_SECRET=
# Legado (1 app) — tratado como serviços se SERVICOS_* estiver vazio:
# OMIE_APP_KEY=
# OMIE_APP_SECRET=
# OMIE_API_URL=https://app.omie.com.br/api/v1
# OMIE_MOCK=1


# =============================================================================
# EXEMPLO — Projeto Vercel "rom-club-iguatemi" (Production)
# =============================================================================
# ROM_PANEL=iguatemi
# NEXT_PUBLIC_ROM_PANEL=iguatemi
# ROM_SEED_PRESET=iguatemi
# AVEC_UNIT_ID=99801
# AVEC_SKIP_REPORT_0011=1
# DATABASE_URL=postgresql://...pooler.supabase.com...   ← banco dedicado
# AVEC_API_TOKEN=token_da_loja_iguatemi              ← token Avec Iguatemi
# ROM_SESSION_SECRET=(openssl rand -hex 32)
# CRON_SECRET=(openssl rand -hex 32)                 ← diferente do Brasil
# Webhooks apontam para https://iguatemi.romclub.com.br/api/webhooks/...
# =============================================================================


# --- Zig Pay (consumo Baru na Folha) ---
# Token Bearer da API enterprise-postgres. Sem token, o botão retorna 503.
ZIG_API_TOKEN=
# Opcional — default https://api.zigcore.com.br
# ZIG_API_BASE=https://api.zigcore.com.br
# Nome do RPC de transações detalhadas (ajustar se o tenant usar outro)
# ZIG_TRANSACTIONS_RPC=getDetailedTransactionsAtPlace
# Place IDs (defaults: Jardins / Iguatemi dos samples RH)
# ZIG_PLACE_ID_BRASIL=d5340303-fd78-4aaf-8e15-4807c0793db9
# ZIG_PLACE_ID_IGUATEMI=eb40fde9-7dd1-4330-89f2-21398b106635
