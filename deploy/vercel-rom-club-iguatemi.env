# =============================================================================
# VERCEL — Projeto: rom-club-iguatemi (Production)
# Cole cada variável em Settings → Environment Variables → Production
# NUNCA copie DATABASE_URL ou AVEC_API_TOKEN do projeto rom-club-brasil
# =============================================================================
#
# REQUIRED (verificar valores na Vercel UI — secrets já costumam existir):
# | Var                    | Valor esperado                          | Status tipico        |
# |------------------------|-----------------------------------------|----------------------|
# | ROM_PANEL              | iguatemi                                | já set — conferir    |
# | AVEC_UNIT_ID           | 99801                                   | VERIFICAR / setar    |
# | AVEC_SKIP_REPORT_0011  | 1                                       | VERIFICAR / setar    |
# | DATABASE_URL           | Supabase pooler (*pooler.supabase.com)  | já set — conferir host|
# | ROM_SESSION_SECRET     | openssl rand -hex 32                    | VERIFICAR (produção) |
# | CRON_SECRET            | openssl rand -hex 32 (≠ Brasil)         | já set — conferir    |
# | AVEC_API_TOKEN         | token loja Iguatemi                     | já set — rotacionar? |
#
# =============================================================================

ROM_PANEL=iguatemi
NEXT_PUBLIC_ROM_PANEL=iguatemi
ROM_SEED_PRESET=iguatemi

# Supabase — projeto dedicado Iguatemi (pooler *.pooler.supabase.com)
DATABASE_URL=

# Avec — unidade Iguatemi (REQUIRED); 0011 não suportado → pula p/ 0007
AVEC_UNIT_ID=99801
AVEC_SKIP_REPORT_0011=1

# HMAC sessões (REQUIRED em produção)
ROM_SESSION_SECRET=

ROM_ADMIN_USER=admin
ROM_ADMIN_PASSWORD=

# Segredo NOVO — não reutilize o CRON_SECRET do Brasil
# Gerar: openssl rand -hex 32
CRON_SECRET=

# Avec — token EXCLUSIVO da loja Iguatemi
AVEC_API_URL=https://api.avec.beauty
AVEC_API_TOKEN=
AVEC_SYNC_MAX_PAGES=200
AVEC_WEBHOOK_SECRET=

# Claude — pode ser a mesma ANTHROPIC_API_KEY do Brasil
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# WhatsApp — instância e número da unidade Iguatemi
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=rom-iguatemi
WHATSAPP_WEBHOOK_SECRET=

# Telegram — bot dedicado Iguatemi (criar via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_IDS=

# =============================================================================
# Webhooks (após domínio configurado)
# WhatsApp: https://SEU-DOMINIO-IGUATEMI/api/webhooks/whatsapp
# Telegram: https://SEU-DOMINIO-IGUATEMI/api/webhooks/telegram
# Avec:    https://SEU-DOMINIO-IGUATEMI/api/webhooks/avec
# =============================================================================
